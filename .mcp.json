{
  "mcpServers": {
    "app": {
      "type": "stdio",
      "command": "node",
      "args": [
        "tools/app-mcp/server.mjs"
      ],
      "env": {
        "APP_BASE_URL": "http://127.0.0.1:3000"
      }
    },
    "dart": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "dart",
        "mcp-server"
      ]
    },
    "mise": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "mcp"
      ]
    }
  }
}
